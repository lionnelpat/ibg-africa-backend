# Copy to .env for local testing, or set these as environment variables
# in the Dokploy project (Environment tab). Never commit the real .env.

# MySQL root password (shared by the app database and the Keycloak database)
MYSQL_ROOT_PASSWORD=change-me

# Keycloak admin console password (user: admin)
KEYCLOAK_ADMIN_PASSWORD=change-me

# OAuth2 client secret for the "web_app" client — MUST match the "secret"
# value of the web_app client in src/main/docker/realm-config-prod/jhipster-realm.json
CLIENT_SECRET_WEB_APP=change-me
